# Email delivery for the /free-website-audit form (Resend).
# Get a key at https://resend.com — without it, form submissions fail with an
# inline error and the fallback email address is shown.
RESEND_API_KEY=

# Optional overrides. The from address must be on a domain verified in Resend;
# the resend.dev fallback only delivers to the Resend account owner's inbox.
AUDIT_FROM_EMAIL="Zenith Digital <hello@thezenithdigital.com>"
AUDIT_TO_EMAIL=hello@thezenithdigital.com
# Where partner applications and contact-form messages go. Both fall back to
# AUDIT_TO_EMAIL when unset.
PARTNER_TO_EMAIL=hello@thezenithdigital.com
CONTACT_TO_EMAIL=hello@thezenithdigital.com

# Supabase — storage for all three forms (table: form_submissions, one row per
# submission, discriminated by `source`). SERVER ONLY: the service role key
# bypasses row-level security, so it must never be prefixed with NEXT_PUBLIC_
# or reach the browser. Without these the forms still deliver by email alone.
# Project settings > Data API for the URL, > API Keys for the key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Analytics. All three are NEXT_PUBLIC_ by necessity: they ship in the page and
# are not secrets. Leave any of them blank and that tool simply doesn't load,
# which is the right default for local work.
# GA4 measurement ID, Admin > Data streams > Web.
NEXT_PUBLIC_GA_ID=
# PostHog project API key, Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to EU cloud. Set to https://us.i.posthog.com for a US project.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sanity (blog CMS) ---
# Public values, not secrets: the `production` dataset has a public ACL, and
# both ship in the client bundle for the embedded Studio at /studio. The app
# falls back to these exact values when the vars are absent (sanity/env.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=nfi9edhy
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity publish webhook -> POST /api/revalidate.
# Set the SAME string here, in Vercel, and on the webhook in sanity.io/manage.
# Without it the route fails closed and the hourly revalidate takes over.
SANITY_REVALIDATE_SECRET=
