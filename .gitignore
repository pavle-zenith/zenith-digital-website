# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents every var the app reads and
# carries no secrets. Without this negation the '.env*' rule above hides
# it from git and a fresh clone has no record of what needs setting.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
site asset dump/client headshots/Contract PDF formatting.pdf

# Scratch folder for files the remote-device bridge cannot delete (it has no
# rm), so they get moved here instead. Never meant to be committed.
_to_delete/

# Source material, not application code. These stay on disk and out of git:
# together they are ~800MB, which every clone and every Vercel build would
# otherwise pull down to ship a site that never reads a byte of them.
#
# The fonts the app actually loads live in app/fonts/ (see app/fonts/index.ts).
# The folders below are the raw downloads they were extracted from.
Inspiration/
site asset dump/
team section/
inter-display/
saans-font-family/
sf-pro-display (1)/

# Claude Code local settings: machine-specific absolute paths, per-developer.
# The shared .claude/settings.json (if one exists) is still tracked.
.claude/settings.local.json
